{
  "name": "Kocom Wallpad Controller with RS485 2",
  "version": "1.2.0",
  "slug": "kocom_wallpad",
  "description": "Kocom Wallpad Controller for Homeassistant (thermostat, fan)",
  "arch": [
    "armhf",
    "armv7",
    "aarch64",
    "amd64",
    "i386"
  ],
  "url": "https://github.com/HAKorea/addons",
  "startup": "application",
  "boot": "auto",
  "uart": true,
  "map": [
    "share:rw"
  ],
  "options": {
    "RS485": {
      "type": "Socket"
    },
    "Socket": {
      "server": "192.168.x.x",
      "port": 8899
    },
    "Serial": {
      "port1": "/dev/ttyUSB0"
    },
    "MQTT": {
      "anonymous": false,
      "server": "192.168.x.x",
      "username": "id",
      "password": "pw"
    },
    "Wallpad": {
      "thermostat": true,
      "fan": true
    },
    "Advanced": {
      "INIT_TEMP": 22,
      "SCAN_INTERVAL": 300,
      "SCANNING_INTERVAL": 0.8,
      "DEFAULT_SPEED" : "medium",
      "LOGLEVEL" : "info"
    },
    "KOCOM_ROOM_THERMOSTAT": [
      "livingroom",
      "bedroom",
      "room1",
      "room2"
    ]
  },
  "schema": {
    "RS485": {
      "type": "list(Serial|Socket)"
    },
    "Socket": {
      "server": "str?",
      "port": "int?"
    },
    "Serial": {
      "port1": "str?"
    },
    "MQTT": {
      "anonymous": "bool",
      "server": "str",
      "username": "str",
      "password": "str"
    },
    "Wallpad": {
      "thermostat": "bool",
      "fan": "bool"
    },
    "Advanced": {
      "INIT_TEMP": "int(10,30)",
      "SCAN_INTERVAL": "int(100,1000)",
      "SCANNING_INTERVAL": "float",
      "DEFAULT_SPEED" : "str",
      "LOGLEVEL" : "str"
    },
    "KOCOM_ROOM_THERMOSTAT": [
      "str?"
    ]
  }
}
